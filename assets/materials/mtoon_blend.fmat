    { type: sampler2d, name: uv_animation_mask_texture, hint: default_white },
    { type: float, name: uv_animation_scroll_x_speed_factor, default: 0 },
    { type: float, name: uv_animation_scroll_y_speed_factor, default: 0 },
    { type: float, name: uv_animation_rotation_speed_factor, default: 0 },
    { type: float, name: time, default: 0 },

    // Lighting, written every frame.
    { type: vec3, name: light_direction, default: [0.3, 0.8, 0.5] },
    { type: vec3, name: light_color, default: [1, 1, 1] },
    { type: vec3, name: gi_sky_color, default: [0.35, 0.35, 0.38] },
