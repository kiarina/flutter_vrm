fragment {
  float MToonLinearStep(float a, float b, float t) {
    return clamp((t - a) / max(b - a, 1e-5), 0.0, 1.0);
  }

  vec2 MToonUv() {
    vec2 uv = GetUV0() * material_params.uv_scale + material_params.uv_offset;
    float mask = texture(uv_animation_mask_texture, uv).b;
    float t = material_params.time * mask;
    uv += vec2(material_params.uv_animation_scroll_x_speed_factor,
               material_params.uv_animation_scroll_y_speed_factor) * t;
    float r = material_params.uv_animation_rotation_speed_factor * t *
              6.28318530718;
    float c = cos(r);
    float s = sin(r);
    vec2 p = uv - vec2(0.5);
    return vec2(c * p.x - s * p.y, s * p.x + c * p.y) + vec2(0.5);
  }

  void Surface(inout MaterialInputs material) {
    vec2 uv = MToonUv();

    vec4 base_sample = texture(base_color_texture, uv);
    vec4 base = material_params.base_color_factor *
                vec4(SRGBToLinear(base_sample.rgb), base_sample.a);
    float alpha = base.a;
    if (material_params.alpha_mode == 1) {
      if (alpha < material_params.alpha_cutoff) {
        discard;
      }
      alpha = 1.0;
    } else if (material_params.alpha_mode == 0) {
      alpha = 1.0;
    }

    vec3 v = normalize(GetViewDirection());
    vec3 n = normalize(GetWorldNormal());
    // Two-sided surfaces shade their back faces with the flipped normal.
    if (dot(n, v) < 0.0) {
      n = -n;
    }
    vec3 l = normalize(material_params.light_direction);

    // Lit and shade colors, blended by the shifted, toony Lambert term.
    float shading = dot(n, l) + material_params.shading_shift_factor +
                    texture(shading_shift_texture, uv).r *
                        material_params.shading_shift_texture_scale;
    shading = MToonLinearStep(-1.0 + material_params.shading_toony_factor,
                              1.0 - material_params.shading_toony_factor,
                              shading);
    vec3 shade = material_params.shade_color_factor *
                 SRGBToLinear(texture(shade_multiply_texture, uv).rgb);
    vec3 color = mix(shade, base.rgb, shading) * material_params.light_color;

    // Global illumination: a sky / ground ambient, flattened toward its
    // average by giEqualizationFactor.
    vec3 gi_n = mix(material_params.gi_ground_color, material_params.gi_sky_color,
                    n.y * 0.5 + 0.5);
    vec3 gi_uniform =
        (material_params.gi_sky_color + material_params.gi_ground_color) * 0.5;
    vec3 gi = mix(gi_n, gi_uniform, material_params.gi_equalization_factor);
    color += gi * base.rgb;

    color += material_params.emissive_factor *
             SRGBToLinear(texture(emissive_texture, uv).rgb);

    // Rim: matcap plus parametric rim, masked, optionally lit.
    vec3 view_x = normalize(vec3(v.z, 0.0, -v.x));
    vec3 view_y = cross(v, view_x);
    vec2 matcap_uv = vec2(dot(view_x, n), dot(view_y, n)) * 0.495 + 0.5;
    vec3 rim = material_params.matcap_factor *
               SRGBToLinear(texture(matcap_texture, matcap_uv).rgb);
    float parametric = clamp(
        1.0 - dot(n, v) + material_params.parametric_rim_lift_factor, 0.0, 1.0);
    parametric = pow(parametric,
                     max(material_params.parametric_rim_fresnel_power_factor,
                         0.00001));
    rim += parametric * material_params.parametric_rim_color_factor;
    rim *= SRGBToLinear(texture(rim_multiply_texture, uv).rgb);
    rim *= mix(vec3(1.0), material_params.light_color + gi,
               material_params.rim_lighting_mix_factor);
    color += rim;

    material.base_color = vec4(color, alpha);
    PrepareMaterial(material);
  }
