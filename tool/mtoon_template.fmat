// MToon 1.0 (VRMC_materials_mtoon) as a flutter_scene .fmat material.
//
// Template for tool/generate_mtoon.dart, which writes one variant per
// blending / culling / depth-write combination into assets/materials/, plus
// the outline variants: the same surface drawn again with front faces culled
// and the vertices pushed out along their normals (an inverted hull), which
// set is_outline and add the {{VERTEX}} block.
// Edit this file, not the generated ones.
//
// flutter_scene's unlit .fmat materials cannot read the scene's lights yet
// (the per-light hook is not implemented upstream), so the directional light
// and the ambient (global illumination) come in as parameters, which
// VrmAvatar writes every frame from VrmMToonLighting.
material {
  name: "{{NAME}}",
  shading_model: unlit,
  blending: {{BLENDING}},
  culling: {{CULLING}},{{DEPTH_WRITE}}

  parameters: [
    { type: vec4, name: base_color_factor, default: [1, 1, 1, 1] },
    { type: sampler2d, name: base_color_texture, hint: default_white },
    // 0 opaque, 1 mask, 2 blend (glTF alphaMode)
    { type: int, name: alpha_mode, default: 0 },
    { type: float, name: alpha_cutoff, default: 0.5 },

    { type: vec3, name: shade_color_factor, default: [0, 0, 0] },
    { type: sampler2d, name: shade_multiply_texture, hint: default_white },
    { type: float, name: shading_shift_factor, default: 0 },
    { type: sampler2d, name: shading_shift_texture, hint: default_black },
    { type: float, name: shading_shift_texture_scale, default: 1 },
    { type: float, name: shading_toony_factor, default: 0.9 },
    { type: float, name: gi_equalization_factor, default: 0.9 },

    { type: vec3, name: emissive_factor, default: [0, 0, 0] },
    { type: sampler2d, name: emissive_texture, hint: default_white },

    // glTF normalTexture; normal_scale 0 means the material has none.
    { type: sampler2d, name: normal_texture, hint: default_white },
    { type: float, name: normal_scale, default: 0 },

    { type: vec3, name: matcap_factor, default: [1, 1, 1] },
    { type: sampler2d, name: matcap_texture, hint: default_black },
    { type: vec3, name: parametric_rim_color_factor, default: [0, 0, 0] },
    { type: float, name: parametric_rim_fresnel_power_factor, default: 5 },
    { type: float, name: parametric_rim_lift_factor, default: 0 },
    { type: sampler2d, name: rim_multiply_texture, hint: default_white },
    { type: float, name: rim_lighting_mix_factor, default: 1 },

    // KHR_texture_transform of the base color texture plus expression binds.
    { type: vec2, name: uv_offset, default: [0, 0] },
    { type: vec2, name: uv_scale, default: [1, 1] },
    { type: sampler2d, name: uv_animation_mask_texture, hint: default_white },
    { type: float, name: uv_animation_scroll_x_speed_factor, default: 0 },
    { type: float, name: uv_animation_scroll_y_speed_factor, default: 0 },
    { type: float, name: uv_animation_rotation_speed_factor, default: 0 },
    { type: float, name: time, default: 0 },

    // Outline. Only the outline variants read the width inputs.
    { type: int, name: is_outline, default: 0 },
    // 1 worldCoordinates (meters), 2 screenCoordinates (share of the
    // screen height)
    { type: int, name: outline_width_mode, default: 0 },
    { type: float, name: outline_width_factor, default: 0 },
    // Declared samplers are fragment-only, so the width texture cannot scale
    // the hull per vertex; the outline pass discards where it is 0 instead
    // (VRoid uses it as a mask, e.g. to keep only the jaw line of the face).
    { type: sampler2d, name: outline_width_multiply_texture, hint: default_white },
    // 1 when the width texture is set (placeholders are not trusted; see
    // matcap_factor in mtoon.dart).
    { type: int, name: has_outline_width_texture, default: 0 },
    { type: vec3, name: outline_color_factor, default: [0, 0, 0] },
    { type: float, name: outline_lighting_mix_factor, default: 1 },
    // 2 * tan(vertical fov / 2): the screen height at distance 1.
    { type: float, name: outline_screen_scale, default: 0.828 },

    // Lighting, written every frame.
    { type: vec3, name: light_direction, default: [0.3, 0.8, 0.5] },
    { type: vec3, name: light_color, default: [1, 1, 1] },
    { type: vec3, name: gi_sky_color, default: [0.35, 0.35, 0.38] },
    { type: vec3, name: gi_ground_color, default: [0.2, 0.19, 0.18] },
  ],
}
{{VERTEX}}
fragment {
  float MToonLinearStep(float a, float b, float t) {
    return clamp((t - a) / max(b - a, 1e-5), 0.0, 1.0);
  }

  vec2 MToonUv() {
    vec2 uv = GetUV0() * material_params.uv_scale + material_params.uv_offset;
    float mask = texture(uv_animation_mask_texture, uv).b;
    float t = material_params.time * mask;
    uv += vec2(material_params.uv_animation_scroll_x_speed_factor,
               material_params.uv_animation_scroll_y_speed_factor) * t;
    float r = material_params.uv_animation_rotation_speed_factor * t *
              6.28318530718;
    float c = cos(r);
    float s = sin(r);
    vec2 p = uv - vec2(0.5);
    return vec2(c * p.x - s * p.y, s * p.x + c * p.y) + vec2(0.5);
  }

  void Surface(inout MaterialInputs material) {
    vec2 uv = MToonUv();

    vec4 base_sample = texture(base_color_texture, uv);
    vec4 base = material_params.base_color_factor *
                vec4(SRGBToLinear(base_sample.rgb), base_sample.a);
    float alpha = base.a;
    if (material_params.alpha_mode == 1) {
      if (alpha < material_params.alpha_cutoff) {
        discard;
      }
      alpha = 1.0;
    } else if (material_params.alpha_mode == 0) {
      alpha = 1.0;
    }

    vec3 v = normalize(GetViewDirection());
    vec3 n = normalize(GetWorldNormal());
    // Two-sided surfaces (and the outline hull) shade their back faces with
    // the flipped normal.
    if (dot(n, v) < 0.0) {
      n = -n;
    }
    if (material_params.normal_scale != 0.0) {
      // PerturbNormal builds the tangent frame from screen-space derivatives
      // of the (unnormalized) view vector, which only its derivative needs.
      n = PerturbNormal(normal_texture, n, -GetWorldPosition(), uv,
                        material_params.normal_scale);
    }
    vec3 l = normalize(material_params.light_direction);

    // Lit and shade colors, blended by the shifted, toony Lambert term.
    float shading = dot(n, l) + material_params.shading_shift_factor +
                    texture(shading_shift_texture, uv).r *
                        material_params.shading_shift_texture_scale;
    shading = MToonLinearStep(-1.0 + material_params.shading_toony_factor,
                              1.0 - material_params.shading_toony_factor,
                              shading);
    vec3 shade = material_params.shade_color_factor *
                 SRGBToLinear(texture(shade_multiply_texture, uv).rgb);
    vec3 color = mix(shade, base.rgb, shading) * material_params.light_color;

    // Global illumination: a sky / ground ambient, flattened toward its
    // average by giEqualizationFactor.
    vec3 gi_n = mix(material_params.gi_ground_color, material_params.gi_sky_color,
                    n.y * 0.5 + 0.5);
    vec3 gi_uniform =
        (material_params.gi_sky_color + material_params.gi_ground_color) * 0.5;
    vec3 gi = mix(gi_n, gi_uniform, material_params.gi_equalization_factor);
    color += gi * base.rgb;
    if (material_params.is_outline == 1) {
      if (material_params.has_outline_width_texture == 1 &&
          texture(outline_width_multiply_texture, uv).g < 0.004) {
        discard;
      }
      material.base_color = vec4(
          material_params.outline_color_factor *
              mix(vec3(1.0), color, material_params.outline_lighting_mix_factor),
          alpha);
      PrepareMaterial(material);
      return;
    }

    color += material_params.emissive_factor *
             SRGBToLinear(texture(emissive_texture, uv).rgb);

    // Rim: matcap plus parametric rim, masked, optionally lit.
    vec3 view_x = normalize(vec3(v.z, 0.0, -v.x));
    vec3 view_y = cross(v, view_x);
    vec2 matcap_uv = vec2(dot(view_x, n), dot(view_y, n)) * 0.495 + 0.5;
    vec3 rim = material_params.matcap_factor *
               SRGBToLinear(texture(matcap_texture, matcap_uv).rgb);
    float parametric = clamp(
        1.0 - dot(n, v) + material_params.parametric_rim_lift_factor, 0.0, 1.0);
    parametric = pow(parametric,
                     max(material_params.parametric_rim_fresnel_power_factor,
                         0.00001));
    rim += parametric * material_params.parametric_rim_color_factor;
    rim *= SRGBToLinear(texture(rim_multiply_texture, uv).rgb);
    rim *= mix(vec3(1.0), material_params.light_color + gi,
               material_params.rim_lighting_mix_factor);
    color += rim;

    material.base_color = vec4(color, alpha);
    PrepareMaterial(material);
  }
}
